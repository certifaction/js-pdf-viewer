{
    "name": "@certifaction/vue-pdf-viewer",
    "version": "7.5.0",
    "description": "PDF-Viewer for Vue.js based on Mozillas PDF.js",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/certifaction/js-pdf-viewer.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "/src"
    ],
    "scripts": {
        "lint:oxlint": "oxlint .",
        "lint:eslint": "eslint . --cache",
        "lint:stylelint": "stylelint \"**/*.{scss,vue}\"",
        "lint": "run-s lint:*",
        "type-check": "vue-tsc --build --force",
        "create-version": "pnpm version --no-git-tag-version"
    },
    "dependencies": {
        "pdfjs-dist": "^6.5.438"
    },
    "peerDependencies": {
        "vue": "^3.5"
    },
    "devDependencies": {
        "@certifaction/vue3-webapp-config": "^19.3.1",
        "@types/jsdom": "^30.0.0",
        "jsdom": "^30.1.3",
        "npm-run-all2": "^9.0.4",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.14"
    }
}
